{
  "name": "tumblehorde",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "test": "npm test -w shared",
    "typecheck": "tsc -p shared && tsc -p client && tsc -p server",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "^7.0.2"
  }
}
